{
  "info": {
    "_postman_id": "credit-card-payment-system",
    "name": "Credit Card Payment System API",
    "description": "Postman collection for the Django and FastAPI APIs of the Credit Card Payment System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "django_base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "fastapi_base_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "card_id",
      "value": "1"
    },
    {
      "key": "payment_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"email\": \"postman@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{django_base_url}}/api/auth/register/"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{django_base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/auth/me/"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{django_base_url}}/api/auth/token/refresh/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{django_base_url}}/api/auth/logout/"
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Add Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_type\": \"CREDIT\",\n  \"card_holder_name\": \"Postman User\",\n  \"card_number\": \"4111111111111111\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2030\n}"
            },
            "url": "{{django_base_url}}/api/cards/"
          }
        },
        {
          "name": "List Cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/cards/"
          }
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/cards/{{card_id}}/"
          }
        }
      ]
    },
    {
      "name": "Payments (FastAPI)",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"card_id\": 1,\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{fastapi_base_url}}/api/payments/?user_id={{user_id}}"
          }
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "url": "{{fastapi_base_url}}/api/payments/{{payment_id}}/process"
          }
        },
        {
          "name": "Create Payment (with fraud signals)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{fastapi_base_url}}/api/payments/?user_id={{user_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": 6000,\n  \"currency\": \"INR\",\n  \"category\": \"SHOPPING\",\n  \"device_id\": \"postman-device\",\n  \"location_id\": \"Asia/Kolkata\"\n}"
            }
          }
        }
      ]
    },
