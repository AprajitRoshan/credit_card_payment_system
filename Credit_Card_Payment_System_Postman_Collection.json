{
  "info": {
    "_postman_id": "credit-card-payment-system",
    "name": "Credit Card Payment System API",
    "description": "Postman collection for the Django and FastAPI APIs of the Credit Card Payment System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "django_base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "fastapi_base_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "card_id",
      "value": "1"
    },
    {
      "key": "payment_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"email\": \"postman@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{django_base_url}}/api/auth/register/"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{django_base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/auth/me/"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{django_base_url}}/api/auth/token/refresh/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{django_base_url}}/api/auth/logout/"
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "Add Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_type\": \"CREDIT\",\n  \"card_holder_name\": \"Postman User\",\n  \"card_number\": \"4111111111111111\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2030\n}"
            },
            "url": "{{django_base_url}}/api/cards/"
          }
        },
        {
          "name": "List Cards",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/cards/"
          }
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/cards/{{card_id}}/"
          }
        }
      ]
    },
    {
      "name": "Payments (FastAPI)",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"card_id\": 1,\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{fastapi_base_url}}/api/payments/?user_id={{user_id}}"
          }
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "url": "{{fastapi_base_url}}/api/payments/{{payment_id}}/process"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "All Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/transactions/"
          }
        },
        {
          "name": "Filter by Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/transactions/?status=SUCCESS"
          }
        },
        {
          "name": "Filter by Amount",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/transactions/?min_amount=600&max_amount=800"
          }
        },
        {
          "name": "Filter by Date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/transactions/?date=2026-10-01"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/admin/dashboard/"
          }
        },
        {
          "name": "Export Transactions CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/admin/transactions/export/"
          }
        }
      ]
    },
    {
      "name": "API Documentation",
      "item": [
        {
          "name": "Django OpenAPI Schema",
          "request": {
            "method": "GET",
            "url": "{{django_base_url}}/api/schema/"
          }
        },
        {
          "name": "FastAPI Swagger",
          "request": {
            "method": "GET",
            "url": "{{fastapi_base_url}}/docs"
          }
        }
      ]
    }
  ]
}