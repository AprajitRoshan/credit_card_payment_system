              }
            ],
            "url": "{{django_base_url}}/api/transactions/analytics/?month=10&year=2026"
          }
        },
        {
          "name": "Export Analytics CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{django_base_url}}/api/transactions/analytics/export/csv/?month=10&year=2026"
          }
        },
        {
