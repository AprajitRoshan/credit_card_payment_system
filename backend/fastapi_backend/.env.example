# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/credit_card_payment_db

# Must equal Django's SECRET_KEY so Django-issued JWTs can be verified.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Must match the Django .env value.
INTERNAL_NOTIFICATION_SECRET=change-me

# Django API used for email notifications.
DJANGO_API_URL=http://127.0.0.1:8000/api

# Fraud rule tuning (optional)
FRAUD_HIGH_VALUE_THRESHOLD=5000
FRAUD_WINDOW_MINUTES=10
FRAUD_RAPID_COUNT=3
FRAUD_HIGH_VALUE_COUNT=2
