# Copy to .env and fill in real values. Never commit .env.

DB_NAME=credit_card_payment_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Use DB_ENGINE=sqlite for a quick local run without MySQL.
# DB_ENGINE=sqlite

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com

# Print emails to the console instead of sending them (local testing):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Must match the FastAPI .env value.
INTERNAL_NOTIFICATION_SECRET=change-me

# Used by the admin System Health panel.
FASTAPI_HEALTH_URL=http://127.0.0.1:8001/health
SLOW_REQUEST_THRESHOLD_MS=1000
